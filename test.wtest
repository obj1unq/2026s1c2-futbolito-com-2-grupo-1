import objetos.*
import pgmProgram.*

describe "patear pelota" {
    method initialize() {
       game.clear()
       game.width(15) 
       game.height(10)
       lionel.position(game.at(5, 5))
       pelota.position(game.at(5, 5))
       
       game.addVisual(lionel)
       game.addVisual(pelota)
    }
  test "lionel patea pelota y esta avanza 3 posiciones" {
    lionel.patear()
    assert.equals(game.at(8,5), pelota.position())
  }

  test "lionel patea nuevamente la pelota pero avanza 1 posicion"{
    lionel.position(game.at(13, 5))
    pelota.position(game.at(13,5))
    lionel.patear()
    assert.equals(game.at(14,5), pelota.position())
  }

  test "Lionel no esta en la misma posicion que la pelota" {
    lionel.position(game.at(3,5))
    lionel.patear()
    assert.equals(game.at(5,5),pelota.position())
  }

}

