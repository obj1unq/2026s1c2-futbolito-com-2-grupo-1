import wollok.game.*
import objetos.*

describe "Requerimiento Taquito" {
    method initialize() {
        game.clear()
        game.width(15) 
        game.height(10)
        lionel.position(game.at(5, 5))
        pelota.position(game.at(5, 5))
        
        game.addVisual(lionel)
        game.addVisual(pelota)


    }
    test "Lionel hace un taquito y la pelota retrocede x" {
        lionel.taquito()
        assert.equals(game.at(3, 5), pelota.position())
    }

    test "Lionel hace taquito pegado al borde y la pelota no sale del tablero" {
        lionel.position(game.at(1, 5))
        pelota.position(game.at(1, 5))
        lionel.taquito()
        assert.equals(game.at(0, 5), pelota.position())
    }

    test "Lionel aprieta T pero la pelota esta lejos" {
        lionel.position(game.at(5, 5))
        pelota.position(game.at(8, 5))
        lionel.taquito()
        assert.equals(game.at(8, 5), pelota.position())
    }
}
